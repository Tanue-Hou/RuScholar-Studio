# Optional cloud judge provider
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Local model and rule resources
THESIS_BUTLER_MODEL_PATH=models/Qwen3-4B-Q5_K_M.gguf
THESIS_BUTLER_MODEL_URL=https://modelscope.cn/models/Qwen/Qwen3-4B-GGUF/resolve/master/Qwen3-4B-Q5_K_M.gguf
THESIS_BUTLER_RULES_PATH=naturalization_layer/rules/polishing_rules_v5.json

# llama.cpp GPU offload. Use -1 for full offload, 0 for CPU-only fallback.
THESIS_BUTLER_GPU_LAYERS=-1

# Web UI
THESIS_BUTLER_HOST=0.0.0.0
THESIS_BUTLER_PORT=8000
