# This file is loaded automatically from the project root as `.env` (real env vars win).

# Optional cloud judge provider. The key is used when a cloud/hybrid run has no key in the request.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Local model and rule resources
RUSCHOLAR_MODEL_PATH=models/Qwen3-8B-Q5_K_M.gguf
RUSCHOLAR_MODEL_URL=https://modelscope.cn/models/Qwen/Qwen3-8B-GGUF/resolve/master/Qwen3-8B-Q5_K_M.gguf
RUSCHOLAR_RULES_PATH=naturalization_layer/rules/polishing_rules_v5.json
RUSCHOLAR_CALIBRATION_PATH=naturalization_layer/calibration/calibration_config.json

# llama.cpp GPU offload. Use -1 for full offload, 0 for CPU-only fallback.
RUSCHOLAR_GPU_LAYERS=-1

# Web UI
# Loopback only by default. The API is unauthenticated: use 0.0.0.0 only on a trusted network.
RUSCHOLAR_HOST=127.0.0.1
RUSCHOLAR_PORT=8000
# Extra allowed CORS origins (comma-separated); the built UI is same-origin and needs none.
RUSCHOLAR_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Idle sessions (pending analyses, uploaded references) are dropped after this many seconds.
RUSCHOLAR_SESSION_TTL=7200
# Timeout for cloud judge requests, in seconds.
RUSCHOLAR_CLOUD_TIMEOUT=30
# Per-file upload limit (MB) for the manuscript and reference uploads.
RUSCHOLAR_MAX_UPLOAD_MB=50
